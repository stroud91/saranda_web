# Copy to .env and fill in. Never commit real secrets.
FLASK_APP=app
FLASK_ENV=development

# Required in production: a long random value, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# SQLite for local dev (stored in instance/). Use postgresql://user:pass@host/db in production.
DATABASE_URL=sqlite:///dev.db
# Postgres schema used in production
SCHEMA=saranda_schema

# Comma-separated origins allowed to call the API from a browser (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the app (for correct client IPs / HTTPS detection)
TRUSTED_PROXY_HOPS=1
# Rate-limit storage; use redis://host:6379 when running several workers
RATELIMIT_STORAGE_URI=memory://

# =====================================================================
# FREE services: on by default, no keys needed
# =====================================================================
# Open-Meteo weather + sea temperature (free tier is for non-commercial use;
# switch to their paid API plan before commercial launch).
# ExchangeRate-API open feed (free, attribution link shown on the site).
# Set to false to use built-in typical-climate figures and an approximate rate.
LIVE_DATA_ENABLED=true
# OSRM road geometry. The public demo server is free for light use; self-host
# for production traffic, or leave empty to draw straight lines.
OSRM_URL=https://router.project-osrm.org
# Map tiles (frontend build-time variable): osm (default, free) | carto (needs
# a CARTO licence for commercial use) | any https tile URL template.
VITE_MAP_TILES=osm

# =====================================================================
# Guest accounts (email + password): on by default, nothing to pay for
# =====================================================================
ACCOUNTS_ENABLED=true
# Public address of the site. REQUIRED in production for verification / password-reset
# e-mails and PayPal return links (it is never taken from the request's Host header).
PUBLIC_BASE_URL=https://megrooms.com
# Outgoing mail: any mailbox on your hosting works (cPanel → Email Accounts → Connect Devices).
# Empty = no e-mails are sent (sign-up still works; password reset and verification don't).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=bookings@megrooms.com
# Reject passwords found in known data breaches (free Have I Been Pwned range API).
PASSWORD_BREACH_CHECK=true
# Addresses that get the Host desk once they have verified their e-mail.
# (Or create a host from the terminal: flask users create-host you@example.com)
ADMIN_EMAILS=

# =====================================================================
# Payments: OFF until configured (the site falls back to request-to-book)
# =====================================================================
# Share of the stay paid when booking; the rest is paid on arrival. 100 = pay in full.
PAYMENT_DEPOSIT_PERCENT=100

# --- PayPal: works for a business in Albania; guests can also pay by card as a PayPal guest.
# Fees are charged by PayPal per payment (nothing up front). Create a "REST API app" at
# developer.paypal.com to get the two keys. Start with sandbox, then switch to live.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Webhook: in the PayPal app add https://yourdomain/api/webhooks/paypal with the
# "Payment capture" events, then paste the Webhook ID here.
PAYPAL_WEBHOOK_ID=
# Currency PayPal charges: EUR, or USD if your PayPal account only settles in dollars.
PAYPAL_CURRENCY=EUR
# With USD: optional extra % on top of the day's EUR→USD rate (covers PayPal's conversion),
# and an optional fixed rate instead of the live one.
PAYPAL_FX_MARGIN_PERCENT=0
PAYPAL_EUR_USD_RATE=

# --- Bank transfer (SEPA from Europe, SWIFT from elsewhere): free to offer.
# Guests see these details, the amount, a reference and a SEPA QR code; you confirm
# the booking in the Host desk once the money arrives.
BANK_BENEFICIARY=
BANK_IBAN=
BANK_BIC=
BANK_NAME=
# Hours the dates are held for an unpaid transfer, and days once the guest says it was sent.
BANK_HOLD_HOURS=48
BANK_CLAIM_HOLD_DAYS=5

# --- Stripe cards: NOT available to businesses registered in Albania. Only for an EU/US entity.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# =====================================================================
# Other PAID services: OFF until you add keys
# =====================================================================
# AI concierge (Anthropic, billed per token). Empty = free built-in answer engine.
ANTHROPIC_API_KEY=
CONCIERGE_MODEL=claude-opus-5-5
# Google Places ratings/opening hours (billed per request). Empty = hidden.
GOOGLE_MAPS_API_KEY=

# --- Affiliate IDs for outbound booking links (optional, free) ---
BOOKING_AFFILIATE_ID=
GYG_PARTNER_ID=
VIATOR_PARTNER_ID=

# --- Admin API with Clerk tokens (optional; the site's own host accounts above are enough) ---
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=https://megrooms.com
ADMIN_USER_IDS=

# --- Contact ---
WHATSAPP_NUMBER=
CONTACT_EMAIL=bookings@megrooms.com
# Contact messages and guide requests that never became a booking are deleted after
# this many months by the daily `flask users cleanup` (the privacy policy states it).
MESSAGE_RETENTION_MONTHS=24

# --- Business portal ---
# Local businesses add their own profile, apartments, rentals and activities at /business.
# Everything waits for your approval in the Host desk. Needs accounts and outgoing e-mail.
PARTNERS_ENABLED=true
# Most listings one business may have.
PARTNER_MAX_LISTINGS=40

# --- Photos for listings ---
# Largest photo accepted, in MB. Photos are re-saved as JPEG (1600 px and 640 px).
UPLOAD_MAX_MB=10
# Where photos are kept. Empty = instance/uploads, which deploys never touch. Back this folder up.
UPLOAD_DIR=
# Most photos one business may keep.
PARTNER_MAX_PHOTOS=300

# --- Calendar sync with other booking sites ---
# Before a booking is accepted, a stay's imported calendars are re-read if the last check
# is older than this many minutes. Also run `flask calendars sync` from cron (docs/GO-LIVE.md).
CALENDAR_SYNC_MINUTES=30
# Calendar links are only read from Airbnb, Booking.com, Vrbo, HomeAway, Tripadvisor and
# Google Calendar. List extra hosts here, comma-separated, e.g. ical.mychannelmanager.com
CALENDAR_FEED_HOSTS=

# --- Cancellations (your own apartments) ---
# Full refund this many days or more before check-in, a partial refund down to the second
# number, nothing after. Shown on /terms and applied when a guest cancels on their booking page.
CANCEL_FULL_REFUND_DAYS=14
CANCEL_PARTIAL_REFUND_DAYS=7
CANCEL_PARTIAL_REFUND_PERCENT=50

# --- Reviews ---
# Guests who booked here can review a stay after check-out; the daily `flask users cleanup`
# emails them the link. false = no reviews anywhere on the site.
REVIEWS_ENABLED=true

# --- Two-step sign-in (authenticator app) ---
# Optional for everyone. true = the Host desk won't open until the host has switched it on.
# Its secrets are encrypted with a key made from SECRET_KEY: never change SECRET_KEY after launch.
REQUIRE_TWO_STEP_FOR_HOSTS=false

# --- Visitor statistics (Host desk → Visitors) ---
# Counted on the server without cookies; one-day visitor codes are deleted the next day.
STATS_ENABLED=true
# Daily totals are kept this many days.
STATS_KEEP_DAYS=760

# --- Backups (`flask backup run`, daily from cron; see docs/GO-LIVE.md step 11) ---
# Encrypts every backup (AES-256-GCM). Keep a copy of it OFF the server: without it backups can't be opened.
BACKUP_PASSPHRASE=
# Where backups are kept. Empty = instance/backups (never served, readable only by the site's account).
BACKUP_DIR=
# How many to keep: the last N days, plus one per week and one per month going back.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
# Photo archives: how many to keep, and at most one every N days (only when photos changed).
BACKUP_KEEP_PHOTOS=2
BACKUP_PHOTOS_EVERY_DAYS=7
# Optional copy elsewhere: an https:// WebDAV folder. Copies are only sent encrypted (needs BACKUP_PASSPHRASE).
BACKUP_UPLOAD_URL=
BACKUP_UPLOAD_USER=
BACKUP_UPLOAD_PASSWORD=

# --- Alerts (`flask monitor check`, hourly from cron) ---
# Where problem e-mails go. Empty = CONTACT_EMAIL.
ALERT_EMAIL=
# Called after each check (with /fail added when something is wrong), e.g. https://hc-ping.com/<id>
# from healthchecks.io, so you also hear when the server itself stops.
ALERT_HEARTBEAT_URL=
# Warn below this much free disk space (MB).
ALERT_MIN_FREE_MB=500
# Repeat an alert this often while the problem lasts (hours).
ALERT_REPEAT_HOURS=24
# At most one e-mail about errors on the site this often (minutes).
ALERT_ERROR_MINUTES=60
# Warn when a connected calendar hasn't updated for this long (hours).
ALERT_CALENDAR_HOURS=24
# Warn when the HTTPS certificate runs out within this many days.
ALERT_CERT_DAYS=10
# Warn when the newest backup is older than this (hours).
BACKUP_MAX_AGE_HOURS=36

# --- Content ---
# The seeded guide profiles are samples and stay hidden from guests. true = show them (demos only).
SHOW_SAMPLE_GUIDES=false
