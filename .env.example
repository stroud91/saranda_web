# Copy to .env and fill in. Never commit real secrets.
FLASK_APP=app
FLASK_ENV=development

# Required in production: a long random value, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# SQLite for local dev (stored in instance/). Use postgresql://user:pass@host/db in production.
DATABASE_URL=sqlite:///dev.db
# Postgres schema used in production
SCHEMA=saranda_schema

# Comma-separated origins allowed to call the API from a browser (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the app (for correct client IPs / HTTPS detection)
TRUSTED_PROXY_HOPS=1
# Rate-limit storage; use redis://host:6379 when running several workers
RATELIMIT_STORAGE_URI=memory://

# =====================================================================
# FREE services: on by default, no keys needed
# =====================================================================
# Open-Meteo weather + sea temperature (free tier is for non-commercial use;
# switch to their paid API plan before commercial launch).
# ExchangeRate-API open feed (free, attribution link shown on the site).
# Set to false to use built-in typical-climate figures and an approximate rate.
LIVE_DATA_ENABLED=true
# OSRM road geometry. The public demo server is free for light use; self-host
# for production traffic, or leave empty to draw straight lines.
OSRM_URL=https://router.project-osrm.org
# Map tiles (frontend build-time variable): osm (default, free) | carto (needs
# a CARTO licence for commercial use) | any https tile URL template.
VITE_MAP_TILES=osm

# =====================================================================
# PAID services: OFF until you add keys (the site works without them)
# =====================================================================
# Card payments (Stripe fees per transaction). Empty = request-to-book.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# AI concierge (Anthropic, billed per token). Empty = free built-in answer engine.
ANTHROPIC_API_KEY=
CONCIERGE_MODEL=claude-opus-5-5
# Google Places ratings/opening hours (billed per request). Empty = hidden.
GOOGLE_MAPS_API_KEY=

# --- Affiliate IDs for outbound booking links (optional, free) ---
BOOKING_AFFILIATE_ID=
GYG_PARTNER_ID=
VIATOR_PARTNER_ID=

# --- Admin (Clerk) ---
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=https://megrooms.com
ADMIN_USER_IDS=
ADMIN_EMAILS=

# --- Contact ---
WHATSAPP_NUMBER=
CONTACT_EMAIL=bookings@megrooms.com
