# Copy to .env and fill in. Never commit real secrets.
FLASK_APP=app
FLASK_ENV=development

# Required in production: a long random value, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# SQLite for local dev (stored in instance/). Use postgresql://user:pass@host/db in production.
DATABASE_URL=sqlite:///dev.db
# Postgres schema used in production
SCHEMA=saranda_schema

# Comma-separated origins allowed to call the API from a browser (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the app (for correct client IPs / HTTPS detection)
TRUSTED_PROXY_HOPS=1
# Rate-limit storage; use redis://host:6379 when running several workers
RATELIMIT_STORAGE_URI=memory://

# --- Payments (optional: without these, stays use request-to-book) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AI concierge (optional: without a key the built-in answer engine is used) ---
ANTHROPIC_API_KEY=
CONCIERGE_MODEL=claude-opus-5-5

# --- Live data (optional) ---
# Google Places API (New) for ratings/opening hours. Restrict the key to the Places API + your server IP.
GOOGLE_MAPS_API_KEY=
# OSRM routing for road geometry. The public demo server has a fair-use policy; self-host for production traffic.
OSRM_URL=https://router.project-osrm.org
LIVE_DATA_ENABLED=true

# --- Affiliate IDs for outbound booking links (optional) ---
BOOKING_AFFILIATE_ID=
GYG_PARTNER_ID=
VIATOR_PARTNER_ID=

# --- Admin (Clerk) ---
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=https://megrooms.com
ADMIN_USER_IDS=
ADMIN_EMAILS=

# --- Contact ---
WHATSAPP_NUMBER=
CONTACT_EMAIL=bookings@megrooms.com
