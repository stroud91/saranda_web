# Settings for the static build (`npm run build:static`), uploaded straight to
# Namecheap public_html with no Python app. These values end up in the public
# JavaScript, so never put secrets here.
VITE_API_MODE=static
# Where booking / guide / contact requests are sent (pre-filled email).
VITE_CONTACT_EMAIL=bookings@megrooms.com
# WhatsApp number in international format, e.g. +35569XXXXXXX (leave empty to hide WhatsApp).
VITE_WHATSAPP_NUMBER=
# Live weather, sea and exchange rates from free public APIs (set to false to use typical values only).
VITE_LIVE_DATA=true
